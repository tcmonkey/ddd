        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="\{[^\r\n]*;\s*\}"/>
            <property name="ignoreComments" value="true"/>
            <message key="regexp.exceeded" value="FMT-BLOCK: Do not compress method bodies or state changes into one line"/>
        </module>
