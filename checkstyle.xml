            <property name="checks" value="JavadocVariable"/>
            <property name="query" value="//VARIABLE_DEF[MODIFIERS/FINAL and not(MODIFIERS/LITERAL_STATIC) and not(ASSIGN) and parent::OBJBLOCK/CTOR_DEF[parent::OBJBLOCK/parent::CLASS_DEF/MODIFIERS/ANNOTATION//IDENT[@text=('Component','Service','Repository','Controller','RestController','Configuration','DomainService')] and count(parent::OBJBLOCK/CTOR_DEF)=1 and PARAMETERS/PARAMETER_DEF and count(parent::OBJBLOCK/VARIABLE_DEF[MODIFIERS/FINAL and not(MODIFIERS/LITERAL_STATIC)])>=count(PARAMETERS/PARAMETER_DEF) and count(SLIST/EXPR)=count(PARAMETERS/PARAMETER_DEF) and count(SLIST/SEMI)=count(PARAMETERS/PARAMETER_DEF) and not(SLIST/*[not(self::EXPR or self::SEMI or self::RCURLY)]) and not(SLIST/EXPR[not(ASSIGN and count(*)=1)]) and not(SLIST/EXPR/ASSIGN[not(count(*)=2 and DOT[count(*)=2 and LITERAL_THIS and IDENT] and IDENT)])]]/descendant-or-self::node()"/>
        </module>
